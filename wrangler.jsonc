{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGIN": "https://mutiwangn.github.io" },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }]
}
